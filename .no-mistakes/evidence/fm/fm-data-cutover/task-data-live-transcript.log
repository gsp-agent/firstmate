luate(async () => { await Promise.all(document.activeElement.getAnimations().map(a => a.finished.catch(() => {}))); });\nconst focus2 = await page.evaluate(observeFocus);\nassert.equal(focus2.href, expected[1]); assert.equal(focus2.focusVisible, true); assert.notEqual(focus2.boxShadow, \"none\");\nawait page.keyboard.press(\"Enter\");\nawait page.screenshot({ path: `${evidence}/reply-all-second-keyboard-focus.png` });\nawait page.keyboard.press(\"Tab\");\nawait page.keyboard.press(\"Tab\");\nconst noticeSummary = await page.evaluate(() => ({ tag: document.activeElement.tagName, text: document.activeElement.textContent.trim() }));\nassert.equal(noticeSummary.tag, \"SUMMARY\"); assert.equal(noticeSummary.text, \"1 calendar reply\");\nawait page.keyboard.press(\"Enter\");\nawait page.waitForFunction(() => document.querySelector('[data-slot=\"calendar-rsvps\"]').open);\nawait page.keyboard.press(\"Tab\");\nawait page.evaluate(async () => { await Promise.all(document.activeElement.getAnimations().map(a => a.finished.catch(() => {}))); });\nconst focus3 = await page.evaluate(observeFocus);\nassert.equal(focus3.href, expected[2]); assert.equal(focus3.focusVisible, true); assert.notEqual(focus3.boxShadow, \"none\");\nawait page.keyboard.press(\"Enter\");\nawait page.screenshot({ path: `${evidence}/reply-all-calendar-keyboard-focus.png` });\nconst activation = await page.evaluate(() => window.replyActivation);\nassert.deepEqual(activation.map(a => a.href), expected);\nassert(activation.every(a => a.trusted && a.detail === 0));\nconst result = {\n  commit: \"60f1084afa62559cf4c8ea89df23955e4ac3df53\",\n  url: await page.url(),\n  surface: \"Real authenticated Pipe /deals/900441 at the target commit; synthetic messages on disposable local PostgreSQL\",\n  appearance, expected, keyboard: { predecessor, first: focus1, between, second: focus2, noticeSummary, calendar: focus3, activation },\n  activationBoundary: \"Captured trusted Enter-generated link clicks; prevented external m