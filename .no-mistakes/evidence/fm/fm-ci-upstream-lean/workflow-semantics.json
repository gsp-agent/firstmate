{
  "name": "CI",
  "events": {
    "push": {
      "branches": [
        "main",
        "upstream-lean"
      ]
    },
    "pull_request": {
      "branches": [
        "main",
        "upstream-lean"
      ]
    }
  },
  "jobs": [
    "lint",
    "test-coverage",
    "tests-portable-parallel-1",
    "tests-portable-parallel-2",
    "tests-portable-serial",
    "tests-herdr",
    "tests-timing-aggregate",
    "macos-stock-bash",
    "invariants"
  ],
  "no_mistakes_required_workflow_unchanged": true,
  "validation_limit": "Parsed workflow semantics only; GitHub event delivery and no-mistakes checks-passed are owned by later gate phases.",
  "base_events": {
    "push": {
      "branches": [
        "main"
      ]
    },
    "pull_request": {
      "branches": [
        "main"
      ]
    }
  }
}
